# Copy to .env and fill in. Never commit .env.

# The app's Supabase project. Both values are public by design (they ship inside the app); row level security in
# supabase/migrations decides what they can reach. Use the *publishable* (anon) key — never a secret / service-role
# key: the app refuses one.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# Optional: where the web build is hosted (no trailing slash). Friend-challenge links then use https://<host>/challenge/<token>,
# which works without the app installed. Unset, links use the app scheme tactiqo://, which needs the app.
# EXPO_PUBLIC_WEB_URL=https://your-web-host.example

# Local-only secret for scripts/generate-tts.mjs. Never rename this to an EXPO_PUBLIC_ variable: the app must not see it.
GOOGLE_TTS_API_KEY=your-google-cloud-api-key-here
