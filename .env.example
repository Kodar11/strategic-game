# Copy to .env and fill in. Never commit .env.

# The app's Supabase project. Both values are public by design (they ship inside the app); row level security in
# supabase/migrations decides what they can reach. Use the *publishable* (anon) key — never a secret / service-role
# key: the app refuses one.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key

# Optional: where the web build is hosted (no trailing slash). Friend-challenge links then use https://<host>/challenge/<token>,
# which works without the app installed. Unset, links use the app scheme tactiqo://, which needs the app.
# EXPO_PUBLIC_WEB_URL=https://your-web-host.example

# Local-only secret for scripts/generate-tts.mjs. Never rename this to an EXPO_PUBLIC_ variable: the app must not see it.
GOOGLE_TTS_API_KEY=your-google-cloud-api-key-here

# Google sign-in (src/auth/google.ts). The *Web* OAuth client id from Google Cloud — public by design: it is the
# audience Supabase checks on the ID token. Never put the Google client *secret* here; it belongs only in the Supabase
# dashboard (Authentication → Providers → Google). See docs/AUTHENTICATION.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
# Later, for iOS only: the iOS OAuth client id.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-yyyyyyyy.apps.googleusercontent.com

# Observability (src/observability, docs/OBSERVABILITY.md). Off unless EXPO_PUBLIC_POSTHOG_ENABLED is exactly "true".
# Keep it unset/false in production until the privacy policy and Play Data Safety describe the collection (release gate).
# The *project* API key (phc_…) is public by design; `eas integrations:posthog:connect` writes these two.
# EXPO_PUBLIC_POSTHOG_ENABLED=true
# EXPO_PUBLIC_POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxx
# EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Session replay sample rate, 0–1. 0 (default) = off. Raise only after the replay checks in docs/OBSERVABILITY.md.
# EXPO_PUBLIC_POSTHOG_REPLAY_SAMPLE_RATE=0
# Source-map and native-symbol upload during EAS builds. SECRET — an EAS "secret" variable only, never EXPO_PUBLIC_,
# never committed. Without it builds still work (stack traces stay minified). Written by the integration command.
# POSTHOG_CLI_API_KEY=phx_...
# POSTHOG_CLI_PROJECT_ID=12345
# POSTHOG_CLI_HOST=https://eu.posthog.com
