    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.28",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "i18next": "^26.5.3",
    "lucide-react-native": "^1.59.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.1.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@electric-sql/pglite": "^0.5.12",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "mpg123-decoder": "^1.0.3",
    "tailwindcss": "~3.4.17",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/__tests__/*.test.ts\" \"supabase/__tests__/*.test.ts\" \"scripts/__tests__/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "tts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-tts.mjs",
    "tts:audition": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-tts.mjs --audition",
    "stories:clips": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/story-audio/story-clips.mjs",
    "stories:audio:fetch": "node scripts/story-audio/fetch-sources.mjs",
    "stories:audio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/story-audio/render.mjs",
    "tts:curriculum": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/curriculum-clips.mjs",
    "content:seed-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/content/tools.ts seed-sql",
    "content:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/content/tools.ts validate",
    "content:pull": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env scripts/content/tools.ts pull"
  },
  "private": true
}
